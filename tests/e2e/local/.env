# PostgreSQL Database (public registry)
POSTGRES_IMAGE=<YOUR_REPOSITORY>/postgres:17.4

# JFrog Platform Services
ARTIFACTORY_IMAGE=<YOUR_REPOSITORY>/jfrog/artifactory-pro:7.160.1
EVIDENCE_IMAGE=<YOUR_REPOSITORY>/jfrog/evidence:7.1285.0

# OneModel Services
ONEMODEL_VERSION=1.92.0
ROUTER_IMAGE=<YOUR_REPOSITORY>/jfrog/router:7.210.0
ONEMODEL_APOLLO_IMAGE=<YOUR_REPOSITORY>/jfrog/onemodelapollo:1.92.0
ONEMODEL_REGISTRY_IMAGE=<YOUR_REPOSITORY>/jfrog/onemodelregistry:1.92.0
APPTRUST_IMAGE=<YOUR_REPOSITORY>/jfrog/apptrust:1.28.7
UP_IMAGE=<YOUR_REPOSITORY>/jfrog/unifiedpolicy:1.32.20
UNIFIED_POLICY_IMAGE=<YOUR_REPOSITORY>/jfrog/unifiedpolicy:1.32.20

# Logging Levels
EVIDENCE_LOG_LEVEL=info
APOLLO_LOG_LEVEL=info
